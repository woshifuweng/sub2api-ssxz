# 主目录只用来放"判断真相"的文档和运维脚本。
# 代码在 .codex-work/ 里（那是独立的 git 仓库），构建产物和数据不进版本库。

# 数据库 dump / 备份 —— 含用户数据，绝对不能提交
*.dump
*.sql
backups/
sub2api-offsite-pending.*

# 真源码树（自带 .git，不是本仓库的内容）
.codex-work/
backend/
frontend/

# Go 构建缓存（数 GB）
go-cache/
go-modcache/

# 构建产物 / 运行时输出
sub2api_linux
sub2api_windows
*.exe
artifacts/
output/
logs/
*.log

# 凭证
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
